# Copy to /etc/hermes/openwebui.env on docker01 and fill in. Never commit the real file.
# The Komodo stack sets OPENWEBUI_ENV_FILE=/etc/hermes/openwebui.env.

# LiteLLM virtual key for this stack — NEVER the LiteLLM master key.
# Mint with scripts/mint-service-key.sh --alias openwebui --models all-proxy-models
# in the TevaServices/hermes repo.
OPENAI_API_KEY=

# Self-hosted Firecrawl key. Must equal the hermes stack's firecrawl.env TEST_API_KEY.
FIRECRAWL_API_KEY=

# Zitadel OIDC application credentials for https://chat.teva.services/oauth/callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Open WebUI session/signing secret. Preserve it across redeploys.
WEBUI_SECRET_KEY=
